# ============================================================
# Placeholder environment file. NEVER commit real credentials.
# ============================================================
# Copy this file to .env and fill in ONLY what you are authorized to use.

# === Facebook session (choose ONE of the two mechanisms below) ===

# 1) Browser profile created by YOU via `python -m src.main --mode login`.
#    A visible Chrome window opens; you log in MANUALLY (no automation,
#    no CAPTCHA bypass). The authenticated profile is stored here and is
#    reused by the (un)headless scraper automatically. Leave blank to use
#    the default `data/browser_profiles/facebook`.
FACEBOOK_PROFILE_DIR=

# 2) Path to a cookies JSON file exported from YOUR OWN authorized,
#    logged-in browser session. Do NOT use stolen/session credentials.
FACEBOOK_COOKIES_FILE=

# Alternative (only if an authorized local login flow is implemented):
FACEBOOK_USERNAME=
FACEBOOK_PASSWORD=

# Optional API adapter credentials (only if you later integrate a
# legitimate, authorized API-compatible data source):
API_BASE_URL=
API_TOKEN=

# === LLM labeling ===
# Used by `python -m src.main --mode enhance` (see config/settings.yaml -> llm).
# Keep the key here, in .env (git-ignored); it is read at runtime only.
# Free tier option: Qwen 27B via OpenRouter (https://openrouter.ai/keys) ->
#   set llm.provider=openai_compatible, endpoint=https://openrouter.ai/api/v1,
#   model=qwen/qwen3.8-27b:free and paste the API key below (OPENROUTER_API_KEY).
#   The ":free" suffix means no billing; free-tier daily quota is generous.
#   List current free models: GET https://openrouter.ai/api/v1/models (filter id ~ :free$).
# Free tier option (alternative): Google Gemini via AI Studio ->
#   set llm.provider=google_gemini and paste the key below (GEMINI_API_KEY).
# Paid option (OpenAI cloud): llm.provider=openai_compatible, endpoint
#   https://api.openai.com -> paste the key below (OPENAI_API_KEY).
# Local Ollama: llm.provider=openai_compatible, endpoint=http://localhost:11434,
#   leave both keys empty.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Logging / runtime knobs
LOG_LEVEL=INFO